# Never commit real credentials or production data.
ASTRA_DEMO=0
ASTRA_LEGACY=1
ASTRA_STATE_DIR=/absolute/persistent/path/focus
FF_SECRET_KEY=replace-with-a-random-secret
FF_DATA=/absolute/path/fleet.json.gz
ASTRA_USERS_FILE=/absolute/private/path/users.json
FF_LLM_PROVIDER=none
# For an authenticated sample installation, omit FF_DATA and use:
# ASTRA_GENERATE_SAMPLE_DATA=1
# ASTRA_ADMIN_USERNAME=your-admin-name
# ASTRA_ADMIN_PASSWORD=set-in-the-host-secret-manager
# For an HTTPS reverse proxy:
# ASTRA_PUBLIC_ORIGIN=https://your-domain.example
